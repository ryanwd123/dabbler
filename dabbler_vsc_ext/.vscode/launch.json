// A launch configuration that compiles the extension and then opens it inside a new window
{
    "version": "0.1",
    "configurations": [
        {
            "name": "Launch Client",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceRoot}",
                // the dabbler repository: python files with SQL in them
                "--folder-uri=${workspaceRoot}/..",
            ],
            "outFiles": [
                "${workspaceRoot}/out/**/*.js"
            ],
            // "preLaunchTask": {
            //     "type": "npm",
            //     "script": "compile"
            // },
        },
    ],
}
