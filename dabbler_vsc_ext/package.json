{
  "name": "dabbler",
  "description": "Completions, hover, signature help and syntax errors for DuckDB SQL in python files; requires the dabbler python package",
  "author": "Ryan DeWitt",
  "repository": "https://github.com/ryanwd123/dabbler",
  "license": "MIT",
  "version": "0.0.9",
  "publisher": "ryanwd123",
  "engines": {
    "node": ">=18",
    "vscode": "^1.82.0"
  },
  "extensionDependencies": [
    "ms-python.python"
  ],
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dabbler.server.restart",
        "title": "Restart Language Server",
        "category": "dabbler"
      },
      {
        "command": "dabbler.server.executeCommand",
        "title": "Execute Command",
        "category": "dabbler"
      },
      {
        "command": "dabbler.server.dbDabblerFormatCurrentStatement",
        "title": "Format current sql statement",
        "category": "dabbler"
      },
      {
        "command": "dabbler.server.sendSqltoDbDabblerCommand",
        "title": "Run current select node in dabbler window",
        "category": "dabbler"
      }
    ],
    "grammars": [
      {
        "path": "./syntaxes/inline-sql.json",
        "scopeName": "inline-sql.injection",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {
          "meta.embedded.sql": "sql"
        }
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "Server Configuration",
        "properties": {
          "dabbler.server.default_py_env": {
            "scope": "window",
            "type": "string",
            "default": "",
            "description": "Path of the python interpreter to run the language server with. If blank, the interpreter selected in the Python extension is used. dabbler must be installed there (pip install \"dabbler[gui]\")."
          },
          "dabbler.trace.server": {
            "scope": "window",
            "type": "string",
            "default": "off",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "description": "Controls if LSP messages send to/from the server should be logged.",
            "enumDescriptions": [
              "do not log LSP messages",
              "log the names of LSP messages",
              "log LSP messages with their contents"
            ]
          }
        }
      },
      {
        "type": "object",
        "title": "Client Configuration",
        "properties": {
          "dabbler.client.documentSelector": {
            "scope": "window",
            "type": "array",
            "items": {
              "type": "object"
            },
            "default": [
              {
                "scheme": "file",
                "language": "python"
              }
            ],
            "description": "The client uses this to decide which documents the server is able to help with.",
            "markdownDescription": "The client uses this to decide which documents the server is able to help with.\n See [DocumentSelector](https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#documentFilter) in the LSP Specification for more details."
          }
        }
      }
    ]
  },
  "main": "./out/main",
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "tsc -p . --noEmit",
    "watch": "tsc -p . --noEmit -w",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "@types/semver": "^7.8.0",
    "@types/vscode": "~1.82.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@vscode/python-extension": "1.0.5",
    "semver": "^7.8.5",
    "vscode-languageclient": "^9.0.1"
  }
}
