start: statement (";" statement)* [";"] -> statements

statement: query -> select_statement
        |PRAGMA expression -> pragma_statement
        |[FORCE] CHECKPOINT [IDENT] -> checkpoint_statement
        |INSTALL STRING -> install_ext_statement
        |LOAD STRING -> load_ext_statement
        |SET [(LOCAL|GLOBAL|SESSION)] IDENT (EQUAL|TO) expression -> set_statement
        |SET VARIABLE IDENT (EQUAL|TO) expression -> set_variable_statement
        |RESET [(LOCAL|GLOBAL|SESSION|VARIABLE)] IDENT -> reset_statement
        |ATTACH [DATABASE] [IF NOT EXISTS] databse_name [_AS alias] ["(" attach_options ("," attach_options)* ")"] -> attach_statement
        |DETACH [DATABASE [IF EXISTS]] databse_name -> detach_statement
        |create_view -> create_view
        |alter_view -> alter_view
        |create_table_statement -> create_table
        |create_sequence -> create_sequence
        |drop_statement -> drop_statement
        |insert_statement -> insert_statement
        |alter_table -> alter_table
        |update_statment -> update_statment
        |CALL IDENT "(" [expression ("," expression)*] ")" -> call_statement
        |USE IDENT ["." IDENT] -> use_statement
        |create_schema -> create_schema
        |copy_statement -> copy_statement
        |create_type -> create_type
        |create_macro -> create_macro
        |delete_statement -> delete_statement
        |TRUNCATE [TABLE] table_name -> truncate_statement
        |EXPLAIN [ANALYZE] statement -> explain_statement
        |(DESCRIBE|SHOW|SUMMARIZE) (query|table_name) -> describe_statement
        |SHOW ALL TABLES -> show_all_tables
        |(BEGIN|START) [TRANSACTION] -> begin_transaction
        |(COMMIT|ROLLBACK|ABORT) [TRANSACTION] -> end_transaction
        |create_index -> create_index
        |create_secret -> create_secret
        |DROP [(PERSISTENT|TEMPORARY)] SECRET [IF EXISTS] IDENT -> drop_secret
        |EXPORT DATABASE [IDENT TO] STRING ["(" option ("," option)* ")"] -> export_database
        |IMPORT DATABASE STRING -> import_database
        |VACUUM [ANALYZE] [table_name [col_names]] -> vacuum_statement
        |ANALYZE [table_name] -> analyze_statement
        |COMMENT ON comment_target table_name IS (STRING|NULL) -> comment_statement

delete_statement: DELETE FROM table_name [[_AS] alias] [USING from_ref ("," from_ref)*] [where] [returning_clause]

create_index: CREATE [UNIQUE] INDEX [IF NOT EXISTS] IDENT ON table_name "(" expression ("," expression)* ")"

create_secret: CREATE [OR REPLACE] [(PERSISTENT|TEMPORARY|TEMP)] SECRET [IF NOT EXISTS] [IDENT] [IN IDENT] "(" option ("," option)* ")"

// a key and its value, as in CREATE SECRET (TYPE s3, KEY_ID '...') or EXPORT DATABASE (FORMAT parquet)
option: (IDENT|TYPE|FORMAT) [expression]

comment_target: TABLE | VIEW | COLUMN | SCHEMA | DATABASE | INDEX | SEQUENCE | TYPE | MACRO [TABLE] | FUNCTION

databse_name:STRING
        |IDENT


update_statment: UPDATE table_name [[_AS] table_name] SET column_update ("," column_update)*  [from_clause] [where]

column_update: _col_ref "=" (expression|query)


create_type: CREATE TYPE IDENT _AS type
        | CREATE TYPE IDENT _AS ENUM "(" query ")"


create_macro: CREATE [OR REPLACE] [TEMP|TEMPORARY] (MACRO|FUNCTION) [IDENT "."] IDENT macro_params _AS (TABLE query|expression) 

macro_params: "(" [macro_param ("," macro_param)*] ")"

macro_param: IDENT [":=" expression]



attach_options: (READ_ONLY|READONLY) [(TRUE|FALSE)] -> read_only
        | TYPE (SQLITE|IDENT) -> attach_type
        | IDENT [expression] -> attach_option

copy_statement: COPY (table_name| "(" query ")" ) [col_names] TO filename [[WITH] "(" copy_to_options ("," copy_to_options)* ")"]
       | COPY (table_name| "(" query ")" ) [col_names] FROM filename [[WITH] "(" copy_from_options ("," copy_from_options)* ")"]

filename: STRING


copy_from_options: FORMAT format_type
        | DELIMITER STRING
        | DELIM STRING
        | SEP STRING
        | NULL STRING
        | HEADER [(TRUE|FALSE)]
        | QUOTE STRING
        | ESCAPE STRING
        | DATEFORMAT STRING
        | TIMESTAMPFORMAT STRING
        | FORCE_NOT_NULL col_names
        | ENCODING STRING
        | AUTO_DETECT [(TRUE|FALSE)]
        | SAMPLE_SIZE NUMBER
        | ALL_VARCHAR [(TRUE|FALSE)]
        | COMPRESSION compression_type
        | CODEC compression_type
        | IDENT (IDENT|STRING|NUMBER)


copy_to_options: FORMAT format_type
        | ALLOW_OVERWRITE [(TRUE|FALSE)]
        | PARTITION_BY col_names
        | PER_THREAD_OUTPUT [(TRUE|FALSE)]
        | USE_TMP_FILE [(TRUE|FALSE)]
        | COMPRESSION compression_type
        | FORCE_QUOTE col_names
        | DELIMITER STRING
        | DATEFORMAT STRING
        | DELIM STRING
        | SEP STRING
        | TIMESTAMPFORMAT STRING
        | ESCAPE STRING
        | HEADER [(TRUE|FALSE)]
        | NULLSTR STRING
        | QUOTE STRING
        | ROW_GROUP_SIAE NUMBER
        | ROW_GROUP_BYTES NUMBER
        | FIELD_IDS struct
        | ARRAY [(TRUE|FALSE)]
        | IDENT (IDENT|STRING|NUMBER)


struct: "{" IDENT ":"  "{" struct_item ("," struct_item)* "}"
struct_item: (IDENT|NUMBER|STRING) ":" (IDENT|NUMBER|STRING)


compression_type: UNCOMPRESSED
        | SNAPPY
        | GZIP
        | ZSTD


format_type: CSV
        |PARQUET
        |JSON




// select_statement: query

create_or_replace: CREATE [OR REPLACE] [(TEMP|TEMPORARY)]

drop_statement: DROP drop_item [IF EXISTS] [IDENT "."] IDENT [(CASCADE|RESTRICT)]

drop_item: FUNCTION
        |INDEX
        |MACRO [TABLE]
        |SCHEMA
        |SEQUENCE
        |TABLE
        |VIEW
        |TYPE

create_schema: CREATE SCHEMA [IF NOT EXISTS] IDENT ["." IDENT]

begin_insert: INSERT [(OR REPLACE|OR IGNORE)] INTO table_name [_AS table_name] [col_names] [(BY POSITION|BY NAME)]
on_conflict_clause: ON CONFLICT [col_names] [WHERE expression] (DO NOTHING|DO UPDATE SET (IDENT "=" expression) ("," IDENT "=" expression)* [WHERE expression])
returning_clause: RETURNING ["*"] [col_exps]
insert_statement: begin_insert (values|query|DEFAULT VALUES) [on_conflict_clause] [returning_clause]


create_table_statement: create_or_replace TABLE [IF NOT EXISTS] table_name (_AS query|col_defintions)

col_defintions: "(" col_defintion ("," col_defintion)* [","] [table_constraints]  ")" 

col_defintion: IDENT type [col_constraint]
        | IDENT generated_col

generated_col: [type] [GENERATED ALWAYS] _AS "(" expression ")" [(VIRTUAL|STORED)]

col_constraint: PRIMARY KEY
        |[NOT] NULL
        |UNIQUE
        |CHECK "(" expression ")"
        |DEFAULT expression
        |REFERENCES table_name col_names
        |COLLATE IDENT

table_constraints: table_constraint ("," table_constraint)* [","]

table_constraint: (PRIMARY KEY|UNIQUE) col_names
        |CHECK "(" expression ")"
        |FOREIGN KEY col_names REFERENCES table_name col_names

alter_table: ALTER TABLE table_name alter_table_cmd

alter_table_cmd: ADD [COLUMN] [IF NOT EXISTS] IDENT type [col_constraint]
        | DROP [COLUMN] [IF EXISTS] alter_col_name
        | ALTER [COLUMN] alter_col_name alter_col_options
        | RENAME [COLUMN] alter_col_name TO IDENT
        | RENAME TO IDENT

alter_col_options: [SET [DATA]] TYPE type [COLLATE IDENT] [USING expression]
                |SET DEFAULT expression
                |DROP DEFAULT



alter_col_name: IDENT


create_view: create_or_replace VIEW table_name [col_names] _AS query

alter_view: ALTER VIEW table_name RENAME TO table_name

col_names: "(" IDENT ("," IDENT)* ")"

create_sequence: create_or_replace SEQUENCE sequence_name [INCREMENT [BY] NUMBER] [(NO MINVALUE|MINVALUE NUMBER)] [(NO MAXVALUE|MAXVALUE NUMBER)] [START [WITH] NUMBER] [[NO] CYCLE] -> create_sequence

sequence_name: IDENT

query.5: _select_node
        | "(" query ")" -> query
        | query UNION [ALL] query -> set_operation
        | query INTERSECT query -> set_operation
        | query EXCEPT query -> set_operation

// ?query_in_parens: "(" query ")"

_select_node: [cte] _select_from _optional_clauses
        | [cte] pivot_clause  [group_by] [order_by]
        | [cte] unpivot_clause [group_by] [order_by]
        | [cte] select_clause
        | [cte] from_clause 
        | cte

pivot_clause: (PIVOT|PIVOT_WIDER) (table_name|subquery|table_func) ON expression ("," expression)* USING col_exp ("," col_exp)*

unpivot_clause: (UNPIVOT|PIVOT_LONGER) (table_name|subquery|table_func) ON (star_options|expression ("," expression)*) INTO NAME alias VALUE col_exp ("," col_exp)*




cte: WITH [RECURSIVE] cte_exp ("," cte_exp)* -> cte
cte_exp: IDENT [cte_col_alias] _AS [MATERIALIZED] "(" query ")" -> cte_expression
cte_name: IDENT
cte_col_alias: "(" IDENT ("," IDENT)* ")" -> cte_col_alias

values: VALUES value ("," value)*[","] -> values
value: "(" expression ("," expression)* ")"

_select_from: select_clause from_clause
        | from_clause select_clause


select_clause: SELECT [(DISTINCT [ON (distinct_on_list)] |ALL)] col_exps
        // |_z9_empty_select_clause

// _z9_empty_select_clause.-3: SELECT

_optional_clauses: [where] [group_by] [having] [qualify] [order_by] [limit]

where.4: WHERE expression
group_by.6: GROUP BY [(expression ",")*] expression
        | GROUP BY ALL
having: HAVING expression
qualify: QUALIFY expression

limit: LIMIT expression [OFFSET expression]
        

distinct_on_list: col_exp [("," col_exp)*]

from_clause: FROM from_ref [("," from_ref)*]
        // |_z9_emtpy_from_clause

// _z9_emtpy_from_clause.-5: FROM

from_ref.3: table_ref [join*]

table_ref.2: table_name [[_AS] alias [col_alias]] [sample_clause] -> db_table
        | "(" query ")" [[_AS] alias [col_alias]] [sample_clause]-> subquery
        | LATERAL "(" query ")" [[_AS] alias [col_alias]] -> lateral_subquery
        |table_func [[_AS] alias [col_alias]] [sample_clause]-> table_function
        // |STRING [[_AS] alias [col_alias]] [sample_clause]-> table_function
        |"(" values ")" [[_AS] alias [col_alias]] -> values

// "USING SAMPLE" is one token so a bare USING after a table alias means JOIN ... USING (...).
// As two tokens the parser has to choose with one token of lookahead and always picked SAMPLE.
sample_clause: (TABLESAMPLE|USING_SAMPLE) [sample_method] "(" NUMBER [("%"|PERCENT|ROWS)] ")" [REPEATABLE "(" NUMBER ")"]
        | (TABLESAMPLE|USING_SAMPLE) NUMBER [("%"|PERCENT|ROWS)]   ["(" sample_method [ "," NUMBER] ")"] 


sample_method: SYSTEM
        | BERNOULLI
        | RESERVOIR



table_func: [[IDENT "."] IDENT "."] IDENT "(" [args] ")"
        |[[IDENT "."] IDENT "."] GLOB "(" [args] ")"
        |STRING          //e.g. select * from 'my_file.csv'

subquery.5: "(" query ")" 

table_name:  [IDENT "." [IDENT "."]] IDENT  -> table_name

// table_name:  [IDENT "." [IDENT "."]] IDENT  -> table_name


col_alias: "(" [(IDENT ",")*] IDENT ")"

join.2: join_type JOIN table_ref [ON expression]
        | join_type JOIN table_ref USING "(" IDENT [("," IDENT)*] ")"

join_type.2: CROSS
        | POSITIONAL
        | [(NATURAL|ASOF)] [(INNER|(LEFT|RIGHT|FULL)[OUTER])]

alias: IDENT

col_exps: col_exp [("," col_exp)*] [","]
col_exp: expression [[_AS] alias]
        | star_options

star_options.9: [IDENT "."] STAR [exclude] [replace] 
        |columns_exp

columns_exp: COLUMNS "(" star_options ")"
        |COLUMNS "(" STRING ")"
        |COLUMNS "(" (lambda_exp|IDENT "->" expression) ")"

lambda_exp: "(" IDENT ("," IDENT)* ")" "->" expression

col_replace: expression _AS IDENT
col_exclude: IDENT
exclude: EXCLUDE "(" [[(col_exclude ",")*] col_exclude] [","] ")"
replace: REPLACE "(" [[(col_replace ",")*] col_replace] [","]")"



// Expressions, loosest binding first. Each level is inlined (?rule) when it has a
// single child, so a plain column reference is still just a col_ref node.
?expression: or_expr

?or_expr: and_expr
        | or_expr OR and_expr -> combine

?and_expr: not_expr
        | and_expr AND not_expr -> combine

?not_expr: predicate
        | NOT not_expr -> not

// comparisons, BETWEEN, IN, LIKE and IS; their operands bind tighter, so
// "a BETWEEN 1 + 1 AND 3" and "a = 1 AND b = 2" group the way SQL means
?predicate: op_expr
        | predicate comp op_expr -> comparison
        | predicate comp (ANY|SOME) "(" query ")" -> comparison
        | predicate [NOT] BETWEEN op_expr AND op_expr -> between
        | predicate [NOT] IN op_expr -> in
        | predicate [NOT] like_op op_expr [ESCAPE op_expr] -> like
        | predicate IS [NOT] (NULL|TRUE|FALSE) -> is_null
        | predicate (ISNULL|NOTNULL) -> is_null
        | predicate NOT NULL -> is_null
        | predicate IS [NOT] DISTINCT FROM op_expr -> is_distinct_from

like_op: LIKE | ILIKE | SIMILAR TO | GLOB | LIKE_SIGN | NOT_LIKE_SIGN | GLOB_SIGN | SIMILAR_TO_SIGN
        | NOT_SIMILAR_TO_SIGN | NOT_ILIKE_SIGN | ILIKE_SIGN

// ||, JSON arrows, bitwise and other operators; x -> x + 1 lambdas parse here too
?op_expr: add_expr
        | op_expr other_op add_expr -> operation

other_op: CONCAT | ARROW | DOUBLE_ARROW | BIT_AND | BIT_OR | SHIFT_LEFT | SHIFT_RIGHT | CONTAINS_OP | CONTAINED_OP | AND_OP

?add_expr: mul_expr
        | add_expr (PLUS|MINUS) mul_expr -> operation

?mul_expr: pow_expr
        | mul_expr (STAR|DIVIDE|INT_DIVIDE|MODULO) pow_expr -> operation

?pow_expr: unary
        | pow_expr POWER unary -> operation

?unary: postfix
        | (MINUS|PLUS|BITWISE_NOT) unary -> unary_op

?postfix: primary
        | postfix CAST_OP type -> cast
        | postfix "[" slice_args "]" -> slice
        | postfix "." IDENT "(" [DISTINCT] [args] ")" [window_form] -> dot_function
        | postfix "." IDENT -> field

?primary: _col_ref -> col_ref
        | _z9_incomplete_col_ref -> z9_incomplete_col_ref
        | STRING -> string
        | NUMBER -> number
        | TRUE -> true
        | FALSE -> false
        | NULL -> null
        | IDENT STRING -> typed_literal
        | INTERVAL (STRING|NUMBER|"(" expression ")") [IDENT] -> interval
        | [IDENT "."] IDENT "(" [DISTINCT] [args] [order_by] ")" [WITHIN GROUP "(" order_by ")"] [filter] [window_form] -> function
        | [IDENT "."] IDENT "(" STAR ")" [filter] [window_form] -> function
        | CASE [expression] (WHEN expression THEN expression)+ [ELSE expression] END -> case
        | (CAST|TRY_CAST) "(" expression _AS type ")" -> cast
        | "(" expression ")" -> parenthesized_expression
        | "(" expression ("," expression)+ [","] ")" -> row
        | "(" query ")" -> subquery
        | EXISTS "(" query ")" -> exists
        | COALESCE "(" expression ("," expression)* ")" -> coalesce
        | EXTRACT "(" IDENT FROM expression ")" -> extract
        | TRIM "(" (BOTH|LEADING|TRAILING) [expression] FROM expression ")" -> trim
        | TRIM "(" expression FROM expression ")" -> trim
        | TRIM "(" expression ["," expression] ")" -> trim
        | SUBSTRING "(" expression FROM expression [FOR expression] ")" -> substring
        | SUBSTRING "(" expression ("," expression)* ")" -> substring
        | LAMBDA IDENT ("," IDENT)* ":" expression -> lambda
        | parameter
        | "[" [expression ("," expression)* [","]] "]" -> list
        | "[" expression FOR IDENT IN expression [IF expression] "]" -> list_comprehension
        | "{" struct_key ":" expression ("," struct_key ":" expression)* [","] "}" -> struct
        | "{" "}" -> struct
        | MAP "{" [expression ":" expression ("," expression ":" expression)* [","]] "}" -> map

// function arguments: values, and named arguments like header := true
args: arg ("," arg)*
arg: expression
        | IDENT ":=" expression -> named_arg

struct_key: STRING | IDENT

slice_args: expression ":" expression [":" expression]
        | expression ":"
        | ":"
        | ":" expression
        | expression

parameter: "?"
        | "$" NUMBER
        | "$" IDENT

_col_ref: [IDENT "."] IDENT

_z9_incomplete_col_ref: [IDENT "."] IDENT "."

filter: FILTER "(" [WHERE] expression ")" -> filter

window_form: OVER (IDENT | "(" window_spec ")")

window_spec: [IDENT] [PARTITION BY (partition_by ",")* partition_by] [order_by [row_range_clause]]

order_by.3: ORDER BY ALL [(ASC|DESC)] [NULLS (FIRST|LAST)]
        | ORDER BY expression [(ASC|DESC)] [NULLS (FIRST|LAST)] ("," expression [(ASC|DESC)] [NULLS (FIRST|LAST)])*

partition_by: expression

row_range_clause: (ROWS | RANGE | GROUPS) frame_extent [EXCLUDE (CURRENT ROW | GROUP | TIES | NO OTHERS)]
frame_extent: frame_between | frame_preceding
frame_between: BETWEEN frame_bound AND frame_bound
frame_bound: frame_preceding | frame_following | CURRENT ROW
frame_preceding: UNBOUNDED PRECEDING | op_expr PRECEDING
frame_following: UNBOUNDED FOLLOWING | op_expr FOLLOWING

comp: GREATER_THAN
        | LESS_THAN
        | LESS_THAN_OR_EQUAL
        | GREATER_THAN_OR_EQUAL
        | EQUAL
        | DOUBLE_EQUAL
        | NOT_EQUALS

// Types: a name (built-in, or the session's own like an ENUM) with optional
// parameters, e.g. VARCHAR(10), DECIMAL(10, 2), STRUCT(a INT, b VARCHAR), INT[].
type: type_name ["(" type_params ")"] array_suffix*
        | type_name WITH TIME ZONE array_suffix*

type_name: IDENT
        | STRUCT | UNION | MAP | ENUM | INTERVAL | NULL

type_params: NUMBER ["," NUMBER]
        | type_field ("," type_field)*
        | type ("," type)*
        | STRING ("," STRING)*

type_field: IDENT type

array_suffix: "[" [NUMBER] "]"

existing_types: type


FILTER: "FILTER"i
LPAREN: "("
RPAREN: ")"
// COMMA: ","
// DOT: "."
PLUS: "+"
MINUS: "-"
STAR: "*"
DIVIDE: "/"
MODULO: "%"
INT_DIVIDE: "//"
POWER: "**" | "^"
