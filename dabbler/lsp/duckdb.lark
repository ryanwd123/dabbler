BIT_OR: "|"
SHIFT_LEFT: "<<"
SHIFT_RIGHT: ">>"
LESS_THAN: "<"
GREATER_THAN: ">"
LESS_THAN_OR_EQUAL: "<="
GREATER_THAN_OR_EQUAL: ">="
NOT_EQUALS: "<>" | "!="
CONCAT: "||"
AND_OP: "&&"
EQUAL: "="
DOUBLE_EQUAL: "=="
ARROW: "->"
DOUBLE_ARROW: "->>"
CONTAINS_OP: "@>"
CONTAINED_OP: "<@"
CAST_OP: "::"
FACTORIAL:   "!"
BITWISE_NOT:   "~"
BITWISE_OR:   "|"
BITWISE_SHIFT_LEFT:   "<<"
BITWISE_SHIFT_RIGHT:   ">>"
BITWISE_AND:   "&"
EXPONENT:   "^"
EXPONENT2:   "**"
INTEGER_DIVIDE:   "//"
LIKE_SIGN:   "~~"
NOT_LIKE_SIGN:   "!~~"
ILIKE_SIGN:   "~~*"
NOT_ILIKE_SIGN:   "!~~*"
SIMILAR_TO_SIGN:   "~"
NOT_SIMILAR_TO_SIGN:   "!~"
GLOB_SIGN: "~~~"



